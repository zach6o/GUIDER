FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim@sha256:531f855bda2c73cd6ef67d56b733b357cea384185b3022bd09f05e002cd144ca
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev
COPY app ./app
COPY scripts/setup_personal_database.py ./scripts/setup_personal_database.py
RUN useradd --uid 10001 --create-home guider
ENV PATH="/app/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1
USER guider
EXPOSE 8000
CMD ["sh", "-c", "python -m scripts.setup_personal_database && exec python -m uvicorn app.personal_app:create_personal_app --factory --workers 1 --host 0.0.0.0 --port ${PORT:-8000} --no-access-log"]
