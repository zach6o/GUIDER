GUIDE_ENVIRONMENT=development
GUIDE_DATABASE_URL=sqlite+aiosqlite:///.local/guide.db
GUIDE_STORAGE_PATH=.local/media
GUIDE_SUPABASE_URL=https://your-project.supabase.co
GUIDE_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# This slice deliberately rejects production startup. See README.md.
# Optional saved-task provider. Blank keeps the deterministic development fixture.
# Remote providers require a key; loopback providers do not.
GUIDE_PROVIDER_ID=
GUIDE_PROVIDER_MODEL=
GUIDE_PROVIDER_API_KEY=
# Separate randomly generated secrets; never put these in the web environment.
GUIDE_CREDENTIAL_ROOT=
GUIDE_MEDIA_ENCRYPTION_KEY=
GUIDE_PROVIDER_DAILY_CALLS=1000
# Managed access remains off unless both configured and the account is entitled.
GUIDE_MANAGED_PROVIDER_ID=
GUIDE_MANAGED_PROVIDER_MODEL=
GUIDE_MANAGED_PROVIDER_KEY=
