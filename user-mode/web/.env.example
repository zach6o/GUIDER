# Leave both blank for the in-memory demo. No data leaves the browser in demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://127.0.0.1:8000/api/v1/guide

# Hosted personal website: set these two Supabase values above and the URL below.
# Leave VITE_API_URL blank for this mode. Never put a provider key or DB password here.
